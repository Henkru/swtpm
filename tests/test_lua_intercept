    def test_log_text_and_binary(self):
        for callback in ("on_request", "on_response"):
            tpm = self.tpm(self.crypto_script('''
assert(print == nil and io == nil and os == nil and debug == nil)
assert(load == nil and loadfile == nil and dofile == nil)
assert(type(require) == "function" and type(package) == "table")
assert(package.loadlib == nil and package.cpath == "")
assert(type(package.searchers[1]) == "function")
assert(type(package.searchers[2]) == "function" and package.searchers[3] == nil)
tpm.log("normal diagnostic")
tpm.log("binary\\0message\\0")
''', callback))
            self.assertEqual(tpm.command(STARTUP), packet(0))
            logs = [r for r in tpm.stop() if r["stage"] == "log"]
            self.assertEqual([bytes.fromhex(r["hex"]) for r in logs],
                             [b"normal diagnostic", b"binary\0message\0"])
            self.assertEqual([r["length"] for r in logs], [17, 15])
            self.assertIn("Lua: normal diagnostic\n", (tpm.path / "stderr").read_text())

    def test_require_lua_files(self):
        script = '''local first
return {api_version=1,on_request=function(ctx)
  local helper = require("helpers.random")
  first = first or helper
  assert(helper == first and helper.value == 0x17b)
  assert(require("helpers.random") == helper)
end}'''
        modules = {
            "helpers/random.lua": '''local value = require("values.random")
return {value=value}''',
            "values/random.lua": "return 0x17b",
        }
        for script_fd in (False, True):
            with self.subTest(script_fd=script_fd):
                tpm = self.tpm(script, modules=modules, script_fd=script_fd)
                self.assertEqual(tpm.command(STARTUP), packet(0))
                # require caches modules after the first load.
