            "tpm.rsa_oaep_sha256_decrypt(string.rep('x',4097),ciphertext,label)",
            "tpm.rsa_oaep_sha256_decrypt(key,ciphertext..'x',label)",
            "tpm.rsa_oaep_sha256_decrypt(key,ciphertext,string.rep('x',65))",
            "tpm.rsa_oaep_sha256_encrypt(modulus..'x',65537,salt,label)",
            "tpm.rsa_oaep_sha256_encrypt(modulus,65537,salt..'x',label)",
            "tpm.rsa_oaep_sha256_encrypt(modulus,65537,salt,string.rep('x',65))",
            "tpm.aes_128_cfb_encrypt(aeskey..'x',iv,salt)",
            "tpm.aes_128_cfb_encrypt(aeskey,iv..'x',salt)",
            "tpm.aes_128_cfb_encrypt(aeskey:sub(2),iv,salt)",
            "tpm.aes_128_cfb_encrypt(aeskey,iv:sub(2),salt)",
            "tpm.aes_128_cfb_decrypt(aeskey..'x',iv,salt)",
            "tpm.aes_128_cfb_decrypt(aeskey,iv..'x',salt)",
            "tpm.aes_128_cfb_decrypt(aeskey:sub(2),iv,salt)",
            "tpm.aes_128_cfb_decrypt(aeskey,iv:sub(2),salt)",
            "tpm.rsa_oaep_sha256_decrypt('',ciphertext,label)",
            "tpm.rsa_oaep_sha256_decrypt(key,ciphertext:sub(2),label)",
            "tpm.rsa_oaep_sha256_encrypt(modulus:sub(2),65537,salt,label)",
            "tpm.rsa_oaep_sha256_encrypt(modulus,65537,salt:sub(2),label)",
            "tpm.rsa_oaep_sha256_encrypt(modulus:sub(1,255)..'\\0',65537,salt,label)",
            "tpm.rsa_oaep_sha256_encrypt('\\0'..modulus:sub(2),65537,salt,label)",
