        stages = [(r["origin"], r["stage"]) for r in records
                  if r.get("id") == 2 or r.get("parent_id") == 2]
        self.assertLess(stages.index(("lua", "request")), stages.index(("external", "effective_request")))
        # Additional commands are in JSONL only; both pcap boundaries stay intact.
        expected = [(True, STARTUP), (False, packet(0)), (True, PCR_READ),
                    (False, first), (True, PCR_READ), (False, second)]
        self.assertEqual(capture(tpm.path / "native.pcapng"), expected)
