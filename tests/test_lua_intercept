    def test_callback_failures(self):
        bodies = [
            "error('callback boom')", "error({})", "while true do end",
            "local x=string.rep('x',17000000)", "return false",
            "return {action='drop'}", "return {action='replace',bytes=123}",
            "return {action='replace',bytes='short'}",
            "return {action='replace',bytes=string.pack('>I2I4I4',0x8001,11,0)}",
            "return {action='replace',bytes=string.pack('>I2I4I4',0x8000,10,0)}",
