                self.assertEqual(bytes.fromhex(records[1]["hex"]), script.encode())
                stages = [r for r in records if r.get("origin") == "external" and r["stage"] != "processing"]
                self.assertEqual([r["id"] for r in stages], [i for i in range(1, 5) for _ in range(5)])
                for i in range(4):
                    self.assertEqual(bytes.fromhex(stages[i * 5]["hex"]), observed[i * 2][1])
                    self.assertEqual(bytes.fromhex(stages[i * 5 + 3]["hex"]), observed[i * 2 + 1][1])
                self.assertFalse(records[-1]["failed"])

