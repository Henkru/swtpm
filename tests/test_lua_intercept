    def test_midrun_log_and_native_capture_failure(self):
        # A real file-size error after successful initialization, with SIGXFSZ
        # ignored so swtpm has to propagate write(2)'s failure itself.
        tpm = self.tpm(file_limit=4096)
        tpm.client.sendall(packet(0x17b, b"x" * 2986))
        self.assertNotEqual(tpm.process.wait(timeout=5), 0)
        self.assertIn("cannot write event log", (tpm.path / "stderr").read_text())
        tpm = self.tpm(native_path="/dev/full")
        self.assertNotEqual(tpm.process.wait(timeout=5), 0)

