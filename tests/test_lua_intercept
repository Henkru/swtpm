    def test_crypto_argument_failures(self):
        bindings = {name: bytes.fromhex(CRYPTO[field]) for name, field in
                    (("key", "private_der"), ("modulus", "modulus"), ("salt", "salt"),
                     ("ciphertext", "ciphertext"), ("label", "label"))}
        bindings.update(aeskey=b"k" * 16, iv=b"i" * 16,
                        ecckey=bytes.fromhex(ECC["attacker_private_der"]),
                        point=bytes.fromhex(ECC["client_public_point"]))
        calls = [
            ("sha256", ["salt"]),
            ("hmac_sha256", ["salt", "salt"]),
            ("rsa_oaep_sha256_decrypt", ["key", "ciphertext", "label"]),
            ("rsa_oaep_sha256_encrypt", ["modulus", "65537", "salt", "label"]),
            ("ecc_p256_salt_from_private", ["ecckey", "point"]),
            ("ecc_p256_salt_to_public", ["point"]),
            ("aes_128_cfb_encrypt", ["aeskey", "iv", "ciphertext"]),
            ("aes_128_cfb_decrypt", ["aeskey", "iv", "ciphertext"]),
        ]
        for function, args in calls:
            for index in range(len(args)):
                for invalid in ("nil", "false", "{}", "123"):
                    # 123 is a valid exponent; separately reject numeric strings/floats.
                    if function == "rsa_oaep_sha256_encrypt" and index == 1 and invalid == "123":
                        continue
                    broken = args.copy()
                    broken[index] = invalid
                    with self.subTest(function=function, argument=index + 1, invalid=invalid):
                        self.crypto_failure("tpm.%s(%s)" % (function, ",".join(broken)), **bindings)
        for exponent in ("0", "1", "2", "4", "-3", "4294967296", "4294967297",
                         "65537.0", "3.5", "'65537'"):
            with self.subTest(exponent=exponent):
                self.crypto_failure("tpm.rsa_oaep_sha256_encrypt(modulus,%s,salt,label)" % exponent,
                                    **bindings)
        # Every declared maximum is exceeded by exactly one byte.
        failures = [
            "tpm.sha256(string.rep('x',1048577))",
            "tpm.hmac_sha256(string.rep('k',1025),salt)",
