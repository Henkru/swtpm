        self.assertIn("exceeds buffer limit", (tpm.path / "stderr").read_text())
        self.assertEqual(tpm.records()[-1]["transmit_calls"], 0)

    def test_transmit_shutdown_bookkeeping(self):
        shutdown = packet(0x145, b"\0\0")
        for callback in ("on_request", "on_response"):
            script = "local shutdown=%s\n" % lua_bytes(shutdown)
            script += '''return {api_version=1,
on_request=function(ctx)
  if ctx.command_code == 0x17b then
    %s
    return {action="respond", bytes=string.pack(">I2I4I4",0x8001,10,0)}
  end
end,
on_response=function(ctx)
  if ctx.command_code == 0x17b then %s end
end}''' % ("tpm.transmit(shutdown)" if callback == "on_request" else "",
           "tpm.transmit(shutdown)" if callback == "on_response" else "")
            tpm = self.tpm(script, auto_shutdown=True)
            tpm.command(STARTUP)
            self.assertEqual(tpm.command(RANDOM), packet(0))
            records = tpm.stop()
            self.assertEqual(records[-1]["transmit_responses"], 1)
            self.assertFalse(any(r.get("origin") == "internal" for r in records))

    def test_preinit_synthetic_and_swtpm_errors(self):
        script = '''return {api_version=1,
on_request=function(ctx, bytes)
  if ctx.command_code == 0x17b then
    ctx.state.synthetic = true
    return {action="respond", bytes=string.pack(">I2I4I4",0x8001,10,0x100)}
  end
end,
on_response=function(ctx, bytes)
  assert(ctx.generation == 0 and not ctx.backend_executed)
  assert(ctx.response_source == (ctx.state.synthetic and "lua" or "swtpm"))
end}'''
        tpm = self.tpm(script, initialize=False)
        self.assertEqual(tpm.command(RANDOM), packet(0x100))
        self.assertNotEqual(tpm.command(STARTUP)[6:10], b"\0" * 4)
        records = tpm.stop()
        self.assertEqual(records[-1]["backend_exchanges"], 0)
        self.assertEqual(capture(tpm.path / "backend.pcapng"), [])

    def test_datafd_generation_and_negotiation(self):
        script = '''local count=0
return {api_version=1,on_request=function(ctx, bytes)
  count=count+1
  assert(ctx.id==count and ctx.generation==count)
  assert(ctx.locality==3)
end}'''
        tpm = self.tpm(script, initialize=False, passed_fd=True)
        response = tpm.ctrl(0x11, struct.pack(">I", 1024), 16)
        self.assertEqual(response[:4], b"\0" * 4)
        self.assertEqual(tpm.ctrl(5, b"\3"), b"\0" * 4)
        for _ in range(2):
            self.assertEqual(tpm.ctrl(2, b"\0" * 4), b"\0" * 4)
            tpm.command(STARTUP)
        tpm.stop()

    def test_negotiated_replacement_limit(self):
        script = '''return {api_version=1,on_request=function(ctx, bytes)
local n=string.unpack(">I2",bytes,11)
return {action="respond",bytes=string.pack(">I2I4I4",0x8001,n,0)..string.rep("x",n-10)}
end}'''
        tpm = self.tpm(script, initialize=False)
        response = tpm.ctrl(0x11, struct.pack(">I", 1024), 16)
        negotiated = struct.unpack_from(">I", response, 4)[0]
        self.assertGreaterEqual(negotiated, 1024)
        tpm.client.sendall(packet(0x17b, struct.pack(">H", negotiated + 1)))
        self.assertNotEqual(tpm.process.wait(timeout=5), 0)

    def test_shutdown_bookkeeping(self):
        for action, replacement in (("respond", packet(0)), ("replace", RANDOM)):
            script = '''return {api_version=1,on_request=function(ctx,bytes)
if ctx.command_code==0x145 then return {action="%s",bytes=string.char(%s)} end
end}''' % (action, ",".join(map(str, replacement)))
            tpm = self.tpm(script, auto_shutdown=True)
            tpm.command(STARTUP)
            tpm.command(packet(0x145, b"\0\0"))
            records = tpm.stop()
            internal = [r for r in records if r.get("origin") == "internal" and r["stage"] == "request"]
            self.assertTrue(internal)
            self.assertEqual(bytes.fromhex(internal[-1]["hex"])[6:10], struct.pack(">I", 0x145))

    def test_script_failures(self):
        scripts = [
