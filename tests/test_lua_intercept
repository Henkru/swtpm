#!/usr/bin/env python3
"""Exercise the public Lua/socket boundary against real libtpms, no mock TPM."""
import array
import hashlib
import hmac
import json
import os
from pathlib import Path
import resource
import shlex
import signal
import socket
import struct
import subprocess
import tempfile
import time
import unittest

from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric import ec
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms
from cryptography.hazmat.decrepit.ciphers.modes import CFB


SWTPM = os.environ.get("SWTPM", str(Path(os.environ.get("abs_top_builddir", ".")) /
                                  "src/swtpm/swtpm"))
PASS = "return {api_version=1,on_request=function() end,on_response=function() end}"
CRYPTO = json.loads((Path(__file__).resolve().parent / "data/lua-crypto.json").read_text())
ECC = CRYPTO["ecc"]
SWTPM_ARGS = tuple(shlex.split(os.environ.get("SWTPM_TEST_ARGS", "")))


def lua_bytes(data):
    return '"' + ''.join('\\x%02x' % byte for byte in data) + '"'


def mgf1(seed, length):
    return b"".join(hashlib.sha256(seed + struct.pack(">I", i)).digest()
                    for i in range((length + 31) // 32))[:length]


def xor_bytes(left, right):
    return bytes(a ^ b for a, b in zip(left, right))


def oaep_encrypt(plaintext, label):
    """Independent, deterministic test-only RSA/OAEP encoding (RFC 8017)."""
    seed = bytes.fromhex(CRYPTO["seed"])
    db = hashlib.sha256(label).digest() + b"\0" * (190 - len(plaintext)) + b"\1" + plaintext
    masked_db = xor_bytes(db, mgf1(seed, 223))
    encoded = b"\0" + xor_bytes(seed, mgf1(masked_db, 32)) + masked_db
    return pow(int.from_bytes(encoded, "big"), CRYPTO["exponent"],
               int(CRYPTO["modulus"], 16)).to_bytes(256, "big")


def oaep_decrypt(ciphertext, label):
    """Decode without using the OpenSSL implementation under test."""
    assert len(ciphertext) == 256
    n = int(CRYPTO["modulus"], 16)
    assert int.from_bytes(ciphertext, "big") < n
    encoded = pow(int.from_bytes(ciphertext, "big"),
                  int(CRYPTO["private_exponent"], 16), n).to_bytes(256, "big")
    assert encoded[0] == 0
    seed = xor_bytes(encoded[1:33], mgf1(encoded[33:], 32))
    db = xor_bytes(encoded[33:], mgf1(seed, 223))
    assert db[:32] == hashlib.sha256(label).digest()
    padding, plaintext = db[32:].split(b"\1", 1)
    assert padding == b"\0" * len(padding)
    return plaintext


def decode_tpm_p256_point(point):
    """Decode the fixed Phase 3 TPMS_ECC_POINT form independently."""
    assert len(point) == 68
    assert point[:2] == b"\0\x20" and point[34:36] == b"\0\x20"
    numbers = ec.EllipticCurvePublicNumbers(
        int.from_bytes(point[2:34], "big"),
        int.from_bytes(point[36:68], "big"), ec.SECP256R1())
    return numbers.public_key()


def kdfe_p256(secret, ephemeral_point, static_point, label=b"SECRET\0"):
    """TPM KDFe/SHA-256 for the fixed 256-bit salt profile."""
    assert len(secret) == 32
    return hashlib.sha256(
        struct.pack(">I", 1) + secret + label +
        ephemeral_point[2:34] + static_point[2:34]).digest()


def p256_ecdh(private_der, public_point):
    private = serialization.load_der_private_key(private_der, password=None)
    assert isinstance(private.curve, ec.SECP256R1)
    return private.exchange(ec.ECDH(), decode_tpm_p256_point(public_point))


def aes_cfb_encrypt(key, iv, plaintext):
    encryptor = Cipher(algorithms.AES(key), CFB(iv)).encryptor()
    return encryptor.update(plaintext) + encryptor.finalize()


def packet(code, body=b"", tag=0x8001):
    return struct.pack(">HII", tag, 10 + len(body), code) + body


STARTUP = packet(0x144, b"\0\0")
RANDOM = packet(0x17B, b"\0\x10")
CAPABILITY = packet(0x17A, struct.pack(">III", 6, 0x100, 1))
PCR_READ = packet(0x17E, struct.pack(">IHB", 1, 0xB, 3) + b"\0\0\1")
PCR_EXTEND = packet(0x182, struct.pack(">II", 16, 9) +
                    bytes.fromhex("400000090000000000") +
                    struct.pack(">IH", 1, 0xB) + b"\x01" * 32, 0x8002)


def recv_exact(sock, count):
    data = b""
    while len(data) < count:
        more = sock.recv(count - len(data))
        if not more:
            raise EOFError(data)
        data += more
    return data


def receive(sock):
    header = recv_exact(sock, 10)
    size = struct.unpack_from(">I", header, 2)[0]
    if not 10 <= size <= 65536:
        raise AssertionError(size)
    return header + recv_exact(sock, size - 10)


def capture(path):
    """Decode the native pcapng Ethernet/IPv4/TCP payloads independently."""
    data = Path(path).read_bytes()
    result = []
    offset = 0
    while offset < len(data):
        kind, length = struct.unpack_from("=II", data, offset)
        assert length >= 12 and length % 4 == 0
        assert struct.unpack_from("=I", data, offset + length - 4)[0] == length
        if kind == 6:
            size = struct.unpack_from("=I", data, offset + 20)[0]
            frame = data[offset + 28:offset + 28 + size]
            ip_size = (frame[14] & 15) * 4
            tcp = 14 + ip_size
            tcp_size = (frame[tcp + 12] >> 4) * 4
            payload = frame[tcp + tcp_size:]
            if payload:
                dest = struct.unpack_from(">H", frame, tcp + 2)[0]
                result.append((dest == 2321, payload))
        offset += length
    assert offset == len(data)
    return result


class TPM:
    def __init__(self, script=PASS, *, initialize=True, auto_shutdown=False,
                 passed_fd=False, script_fd=False, args=(), log_path=None,
                 backend_path=None, file_limit=None, direct_server=False,
                 native_path=None, modules=None):
        self.tmp = tempfile.TemporaryDirectory(prefix="swtpm-lua-")
        self.path = Path(self.tmp.name)
        self.script = script
        source = self.path / "attack, with spaces.lua"
        source.write_text(script or "")
        for name, contents in (modules or {}).items():
            module = self.path / name
            module.parent.mkdir(parents=True, exist_ok=True)
            module.write_text(contents)
        self.client, data = socket.socketpair()
        self.control, control = socket.socketpair()
        self.client.settimeout(5)
        self.control.settimeout(5)
        self.error = open(self.path / "stderr", "wb")
        self.log = open(log_path or self.path / "intercept.jsonl", "wb")
        self.backend = open(backend_path or self.path / "backend.pcapng", "wb")
        self.source = open(source, "rb")
        fds = [control.fileno()]
        cmd = [SWTPM, "socket", "--tpm2", "--tpmstate", "dir=" + str(self.path),
               "--ctrl", "type=unixio,clientfd=" + str(control.fileno()),
               "--pcap", "file=" + str(native_path or self.path / "native.pcapng")]
        if direct_server:
            cmd += ["--server", "type=unixio,path=" + str(self.path / "data.sock")]
        elif not passed_fd:
            fds.append(data.fileno())
            cmd += ["--fd", str(data.fileno())]
        flags = []
        if initialize:
            flags += ["not-need-init"]
        if not auto_shutdown:
            flags += ["disable-auto-shutdown"]
        if flags:
            cmd += ["--flags", ",".join(flags)]
        if script is not None:
            fds += [self.log.fileno(), self.backend.fileno()]
            cmd += ["--lua-log-fd", str(self.log.fileno()),
                    "--lua-pcap-fd", str(self.backend.fileno())]
            if script_fd:
                fds.append(self.source.fileno())
                cmd += ["--lua-script-fd", str(self.source.fileno())]
            else:
                cmd += ["--lua-script", str(source)]
        def limit_files():
            signal.signal(signal.SIGXFSZ, signal.SIG_IGN)
            resource.setrlimit(resource.RLIMIT_FSIZE, (file_limit, file_limit))

        env = None
        if modules:
            env = os.environ.copy()
            env["LUA_PATH"] = ";".join((str(self.path / "?.lua"),
                                          str(self.path / "?/init.lua")))
        self.process = subprocess.Popen(cmd + list(SWTPM_ARGS) + list(args),
                                        pass_fds=fds, env=env,
                                        preexec_fn=limit_files if file_limit else None,
                                        stdout=self.error, stderr=self.error)
        control.close()
        if direct_server:
            self.client.close()
            self.client = socket.socket(socket.AF_UNIX)
            self.client.settimeout(5)
            deadline = time.monotonic() + 5
            while not (self.path / "data.sock").exists():
                if self.process.poll() is not None or time.monotonic() > deadline:
                    raise RuntimeError("direct socket did not become ready")
                time.sleep(0.01)
            self.client.connect(str(self.path / "data.sock"))
        if passed_fd:
            self.control.sendmsg([struct.pack(">I", 0x10)],
                                 [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                                   array.array("i", [data.fileno()]))])
            assert recv_exact(self.control, 4) == b"\0" * 4
        data.close()

    def command(self, command):
        self.client.sendall(command)
        return receive(self.client)

    def ctrl(self, code, body=b"", length=4):
        self.control.sendall(struct.pack(">I", code) + body)
        return recv_exact(self.control, length)

    def stop(self, failure=False):
        if self.process.poll() is None:
            self.process.send_signal(signal.SIGTERM)
        rc = self.process.wait(timeout=5)
        self.error.flush()
        diagnostic = (self.path / "stderr").read_text(errors="replace")
        if failure:
            assert rc != 0, diagnostic
        else:
            assert rc == 0, diagnostic
        return self.records()

    def records(self):
        return [json.loads(line) for line in (self.path / "intercept.jsonl").read_text().splitlines()]

    def close(self):
        if self.process.poll() is None:
            self.process.kill()
            self.process.wait(timeout=5)
        self.client.close()
        self.control.close()
        for fd in (self.error, self.log, self.backend, self.source):
            fd.close()
        self.tmp.cleanup()


class InterceptionTests(unittest.TestCase):
    def tpm(self, *args, **kwargs):
        tpm = TPM(*args, **kwargs)
        self.addCleanup(tpm.close)
        return tpm

    def crypto_script(self, body, callback="on_request", **bindings):
        prefix = "\n".join("local %s = %s" % (name, lua_bytes(value))
                           for name, value in bindings.items())
        return prefix + "\nreturn {api_version=1,%s=function()\n%s\nend}" % (callback, body)

    def crypto_success(self, body, callback="on_request", **bindings):
        tpm = self.tpm(self.crypto_script(body, callback, **bindings))
        self.assertEqual(tpm.command(STARTUP), packet(0))
        return tpm.stop()

    def crypto_failure(self, body, **bindings):
        tpm = TPM(self.crypto_script(body, **bindings))
        try:
            tpm.client.sendall(STARTUP)
            # A signal/crash is not an acceptable Lua error.
            self.assertGreater(tpm.process.wait(timeout=5), 0)
            records = tpm.records()
            self.assertTrue(records[-1]["failed"])
            errors = [r for r in records if r["stage"] == "error" and r["origin"] == "external"]
            self.assertTrue(errors)
            self.assertEqual(errors[-1]["action"], "abort")
            self.assertEqual(records[-1]["completed"], 1)
        finally:
            tpm.close()

    def test_crypto_hash_and_hmac(self):
        # SHA-256("abc") and RFC 4231 section 4.2, HMAC-SHA-256 test case 1.
        vectors = [
            ("tpm.sha256(data)", b"", b"abc",
             bytes.fromhex("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")),
            ("tpm.hmac_sha256(key,data)", b"\x0b" * 20, b"Hi There",
             bytes.fromhex("b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")),
        ]
        for data in (b"", b"a\0b\0c"):
            key = b"key\0with\0zeros"
            vectors += [("tpm.sha256(data)", key, data, hashlib.sha256(data).digest()),
                        ("tpm.hmac_sha256(key,data)", key, data, hmac.digest(key, data, "sha256"))]
        vectors.append(("tpm.hmac_sha256(key,data)", b"", b"", hmac.digest(b"", b"", "sha256")))
        for callback in ("on_request", "on_response"):
            for expression, key, data, expected in vectors:
                with self.subTest(expression=expression, data=data, callback=callback):
                    self.crypto_success("assert(%s == expected)" % expression, callback,
                                        key=key, data=data, expected=expected)

    def test_crypto_aes_cfb(self):
        # NIST SP 800-38A F.3.13/F.3.14, CFB128-AES128.
        key = bytes.fromhex("2b7e151628aed2a6abf7158809cf4f3c")
        iv = bytes.fromhex("000102030405060708090a0b0c0d0e0f")
        ciphertext = bytes.fromhex("3b3fd92eb72dad20333449f8e83cfb4a"
                                   "c8a64537a0b3a93fcde3cdad9f1ce58b"
                                   "26751f67a3cbb140b1808cf187a4f4df"
                                   "c04b05357c5d1c0eeac4c66f9ff7f2e6")
        plaintext = bytes.fromhex("6bc1bee22e409f96e93d7e117393172a"
                                  "ae2d8a571e03ac9c9eb76fac45af8e51"
                                  "30c81c46a35ce411e5fbc1191a0a52ef"
                                  "f69f2445df4f9b17ad2b417be66c3710")
        for callback in ("on_request", "on_response"):
            for length in (0, 1, 15, 16, 17, 31, 64):
                with self.subTest(length=length, callback=callback):
                    self.crypto_success('''
assert(tpm.aes_128_cfb_encrypt(key,iv,plaintext) == ciphertext)
assert(tpm.aes_128_cfb_decrypt(key,iv,ciphertext) == plaintext)
''', callback, key=key, iv=iv, plaintext=plaintext[:length],
                                        ciphertext=ciphertext[:length])
            for length in (2, 14, 18, 47, 255):
                with self.subTest(randomized_length=length, callback=callback):
                    random_key = hashlib.sha256(b"key" + bytes([length])).digest()[:16]
                    random_iv = hashlib.sha256(b"iv" + bytes([length])).digest()[:16]
                    random_plaintext = hashlib.shake_256(
                        b"plaintext" + bytes([length])).digest(length)
                    expected = aes_cfb_encrypt(random_key, random_iv, random_plaintext)
                    self.crypto_success('''
local encrypted = tpm.aes_128_cfb_encrypt(key,iv,plaintext)
assert(encrypted == expected)
assert(tpm.aes_128_cfb_decrypt(key,iv,encrypted) == plaintext)
''', callback, key=random_key, iv=random_iv,
                                        plaintext=random_plaintext, expected=expected)

    def test_crypto_rsa_oaep(self):
        key = bytes.fromhex(CRYPTO["private_der"])
        modulus = bytes.fromhex(CRYPTO["modulus"])
        salt = bytes.fromhex(CRYPTO["salt"])
        known_label = bytes.fromhex(CRYPTO["label"])
        known_ciphertext = bytes.fromhex(CRYPTO["ciphertext"])
        self.assertEqual(oaep_encrypt(salt, known_label), known_ciphertext)
        for callback in ("on_request", "on_response"):
            for label in (known_label, b"", b"\0" * 64):
                with self.subTest(label=label, callback=callback):
                    ciphertext = known_ciphertext if label == known_label else oaep_encrypt(salt, label)
                    records = self.crypto_success('''
assert(tpm.rsa_oaep_sha256_decrypt(key,ciphertext,label) == salt)
local encrypted = tpm.rsa_oaep_sha256_encrypt(modulus,65537,salt,label)
assert(#encrypted == 256)
tpm.log(encrypted)
''', callback, key=key, ciphertext=ciphertext, label=label, salt=salt, modulus=modulus)
                    logs = [bytes.fromhex(r["hex"]) for r in records if r["stage"] == "log"]
                    self.assertEqual(len(logs), 1)
                    self.assertEqual(oaep_decrypt(logs[0], label), salt)
        for exponent in (3, 0xFFFFFFFF):
            self.crypto_success("assert(#tpm.rsa_oaep_sha256_encrypt(modulus,%d,salt,label) == 256)"
                                % exponent, modulus=modulus, salt=salt, label=known_label)

    def test_crypto_ecc_fixed_vectors(self):
        attacker_der = bytes.fromhex(ECC["attacker_private_der"])
        attacker_point = bytes.fromhex(ECC["attacker_public_point"])
        client_der = bytes.fromhex(ECC["client_private_der"])
        client_point = bytes.fromhex(ECC["client_public_point"])
        genuine_der = bytes.fromhex(ECC["genuine_private_der"])
        genuine_point = bytes.fromhex(ECC["genuine_public_point"])
        backend_der = bytes.fromhex(ECC["backend_ephemeral_private_der"])
        backend_point = bytes.fromhex(ECC["backend_ephemeral_public_point"])

        client_secret = p256_ecdh(attacker_der, client_point)
        self.assertEqual(client_secret, bytes.fromhex(ECC["client_shared_secret"]))
        self.assertEqual(p256_ecdh(client_der, attacker_point), client_secret)
        client_salt = kdfe_p256(client_secret, client_point, attacker_point)
        self.assertEqual(client_salt, bytes.fromhex(ECC["client_salt"]))
        self.assertEqual(kdfe_p256(client_secret, attacker_point, client_point),
                         bytes.fromhex(ECC["client_salt_swapped"]))
        self.assertNotEqual(client_salt,
                            kdfe_p256(client_secret, attacker_point, client_point))
        self.assertEqual(kdfe_p256(client_secret, client_point, attacker_point,
                                   b"SECRET"),
                         bytes.fromhex(ECC["client_salt_without_label_nul"]))
        self.assertNotEqual(client_salt,
                            kdfe_p256(client_secret, client_point,
                                      attacker_point, b"SECRET"))

        backend_secret = p256_ecdh(backend_der, genuine_point)
        self.assertEqual(backend_secret, bytes.fromhex(ECC["backend_shared_secret"]))
        self.assertEqual(p256_ecdh(genuine_der, backend_point), backend_secret)
        self.assertEqual(kdfe_p256(backend_secret, backend_point, genuine_point),
                         bytes.fromhex(ECC["backend_salt"]))

        for callback in ("on_request", "on_response"):
            with self.subTest(callback=callback):
                self.crypto_success('''
assert(tpm.ecc_p256_salt_from_private(private_der,ephemeral_point) == expected)
''', callback, private_der=attacker_der, ephemeral_point=client_point,
                                    expected=client_salt)

    def test_crypto_ecc_generated_salts(self):
        genuine_der = bytes.fromhex(ECC["genuine_private_der"])
        genuine_point = bytes.fromhex(ECC["genuine_public_point"])
        for callback in ("on_request", "on_response"):
            with self.subTest(callback=callback):
                records = self.crypto_success('''
local point1,salt1 = tpm.ecc_p256_salt_to_public(static_point)
local point2,salt2 = tpm.ecc_p256_salt_to_public(static_point)
assert(#point1 == 68 and #salt1 == 32)
assert(#point2 == 68 and #salt2 == 32 and point1 ~= point2)
tpm.log(point1..salt1)
tpm.log(point2..salt2)
''', callback, static_point=genuine_point)
                generated = [bytes.fromhex(record["hex"]) for record in records
                             if record["stage"] == "log"]
                self.assertEqual(len(generated), 2)
                self.assertNotEqual(generated[0][:68], generated[1][:68])
                for value in generated:
                    point, salt = value[:68], value[68:]
                    secret = p256_ecdh(genuine_der, point)
                    self.assertEqual(salt, kdfe_p256(secret, point, genuine_point))

    def test_crypto_ecc_result_memory_budget(self):
        # Pre-size the tables before consuming most of Lua's 16-MiB budget so
        # the eventual allocation failure occurs while copying a result pair.
        self.crypto_failure('''
local points,salts = {},{}
for i=1,5000 do points[i]=false salts[i]=false end
local padding = string.rep("x",15*1024*1024)
for i=1,5000 do
  points[i],salts[i] = tpm.ecc_p256_salt_to_public(static_point)
end
''', static_point=bytes.fromhex(ECC["genuine_public_point"]))

    def test_crypto_kdfa(self):
        # KDFa stays in Lua: counter || label || NUL || contexts || bit count.
        for vector in CRYPTO["kdfa"]:
            with self.subTest(label=vector["label"], bits=vector["bits"]):
                self.crypto_success('''
local function kdfa(key,label,u,v,bits)
  local output = ""
  for counter=1,(bits+255)//256 do
    output = output .. tpm.hmac_sha256(key,
      string.pack(">I4",counter)..label.."\\0"..u..v..string.pack(">I4",bits))
  end
  return output:sub(1,(bits+7)//8)
end
assert(kdfa(key,label,u,v,%d) == expected)
''' % vector["bits"], key=bytes.fromhex(vector["key"]), label=vector["label"].encode(),
                    u=bytes.fromhex(vector["context_u"]), v=bytes.fromhex(vector["context_v"]),
                    expected=bytes.fromhex(vector["output"]))

