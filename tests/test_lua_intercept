        self.assertEqual([r["sequence"] for r in injected], [n for n in range(1, 5) for _ in range(3)])
        self.assertEqual([r["phase"] for r in injected], ["on_request"] * 6 + ["on_response"] * 6)
        self.assertTrue(all(r["parent_id"] == 2 and r["generation"] == 1 for r in injected))
        self.assertTrue(all(r["backend_executed"] for r in injected if r["stage"] != "request"))
        self.assertEqual([bytes.fromhex(r["hex"]) for r in injected if r["stage"] == "request"],
