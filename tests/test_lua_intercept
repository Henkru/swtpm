  assert(ctx.id == responses and ctx.backend_executed and ctx.response_source == "tpm")
  assert(ctx.original_request == ctx.effective_request)
  if ctx.id == 2 then
    assert(bytes == ctx.state.before)
    local response, rc = transmit(extend)
